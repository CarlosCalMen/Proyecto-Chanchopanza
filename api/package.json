{
  "name": "restaurant-backend",
  "version": "1.0.0",
  "description": "Sales and purchase management backend for a multi-branch restaurant",
  "main": "server.js",
  "scripts": {
    "start":       "node server.js",
    "dev":         "nodemon server.js",
    "db:migrate":  "sequelize-cli db:migrate",
    "db:rollback": "sequelize-cli db:migrate:undo",
    "db:seed":     "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcryptjs":         "^2.4.3",
    "cookie-parser":    "^1.4.6",
    "cors":             "^2.8.5",
    "dotenv":           "^16.4.5",
    "express":          "^4.19.2",
    "express-validator":"^7.1.0",
    "jsonwebtoken":     "^9.0.2",
    "pg":               "^8.12.0",
    "pg-hstore":        "^2.3.4",
    "sequelize":        "^6.37.3"
  },
  "devDependencies": {
    "nodemon":          "^3.1.4",
    "sequelize-cli":    "^6.6.2"
  }
}
